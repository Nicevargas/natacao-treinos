{
  "name": "Cada Dia 1 Treino - disparo diario",
  "settings": {
    "timezone": "America/Sao_Paulo",
    "executionOrder": "v1"
  },
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 6 * * *"
            }
          ]
        }
      },
      "id": "gatilho-0600",
      "name": "Todo dia as 06:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.github.com/repos/Nicevargas/natacao-treinos/dispatches",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Accept", "value": "application/vnd.github+json" },
            { "name": "X-GitHub-Api-Version", "value": "2022-11-28" },
            { "name": "User-Agent", "value": "n8n-natacao-treinos" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\"event_type\":\"publicar-treino\"}",
        "options": {
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true
            }
          }
        }
      },
      "id": "dispara-actions",
      "name": "Disparar o GitHub Actions",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "deu-204",
              "operator": { "type": "number", "operation": "equals" },
              "leftValue": "={{ $json.statusCode }}",
              "rightValue": 204
            }
          ]
        },
        "options": {}
      },
      "id": "conferir-204",
      "name": "GitHub aceitou?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ok",
              "name": "resultado",
              "type": "string",
              "value": "Disparo aceito. O GitHub Actions esta rodando; o post sai em ~3 min."
            }
          ]
        },
        "options": {}
      },
      "id": "ok",
      "name": "Disparado",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [720, -100]
    },
    {
      "parameters": {
        "errorMessage": "={{ 'O GitHub recusou o disparo (HTTP ' + $json.statusCode + '). Confira se o PAT ainda vale e se tem permissao de Contents neste repositorio. Resposta: ' + JSON.stringify($json.body) }}"
      },
      "id": "falhou",
      "name": "Disparo recusado",
      "type": "n8n-nodes-base.stopAndError",
      "typeVersion": 1,
      "position": [720, 100]
    }
  ],
  "connections": {
    "Todo dia as 06:00": {
      "main": [[{ "node": "Disparar o GitHub Actions", "type": "main", "index": 0 }]]
    },
    "Disparar o GitHub Actions": {
      "main": [[{ "node": "GitHub aceitou?", "type": "main", "index": 0 }]]
    },
    "GitHub aceitou?": {
      "main": [
        [{ "node": "Disparado", "type": "main", "index": 0 }],
        [{ "node": "Disparo recusado", "type": "main", "index": 0 }]
      ]
    }
  }
}
